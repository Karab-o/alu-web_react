{
  "name": "dashboard",
  "version": "1.0.0",
  "description": "Holberton School dashboard built with Webpack and Babel",
  "main": "src/index.js",
  "scripts": {
    "start": "webpack-dev-server --mode development --config config/webpack.config.js",
    "build": "webpack --config config/webpack.config.js",
    "test": "jest",
    "test-watch": "jest --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "aphrodite": "^2.4.0",
    "normalizr": "^3.6.2",
    "prop-types": "^15.8.1",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "redux": "^4.2.1",
    "redux-thunk": "^2.4.2"
  },
  "devDependencies": {
    "@babel/core": "^7.12.10",
    "@babel/preset-env": "^7.12.11",
    "@babel/preset-react": "^7.12.10",
    "babel-jest": "^26.6.3",
    "babel-loader": "^8.2.2",
    "cheerio": "1.0.0-rc.3",
    "css-loader": "^3.2.0",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "^1.15.6",
    "fetch-mock": "^9.11.0",
    "file-loader": "^4.2.0",
    "image-webpack-loader": "^6.0.0",
    "jest": "^26.6.3",
    "node-fetch": "^2.6.7",
    "redux-mock-store": "^1.5.4",
    "style-loader": "^1.0.0",
    "webpack": "^4.41.2",
    "webpack-cli": "^3.3.9",
    "webpack-dev-server": "^3.8.2"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/config/setupTests.js"
    ],
    "moduleNameMapper": {
      "\\.(css|less)$": "<rootDir>/config/styleMock.js",
      "\\.(jpg|jpeg|png|gif|svg|ico)$": "<rootDir>/config/fileMock.js"
    }
  }
}
